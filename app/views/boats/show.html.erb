<div>
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4 pb-3 border-bottom">
    <h2 class="h4 fw-bold text-dark mb-0">
      <%= @boat.Name %>
    </h2>
    
    <div class="d-flex gap-2">
      <%= link_to request.referer, class: "btn btn-outline-secondary btn-sm px-3 rounded-pill d-inline-flex align-items-center" do %>
      <span>Back</span>
      <% end %>
      
      <% if current_user.roles?(['Harbormaster','BOG', 'Admin']) %>
      <%= link_to edit_boat_path(@boat), class: "btn btn-primary btn-sm px-3 rounded-pill d-inline-flex align-items-center shadow-sm" do %>
      <span>Edit Boat</span>
      <% end %>
      <% end %>
    </div>
  </div>
  <hr>
  <table class="table table-sm">
    <tbody>
      <tr>
	<td><b>Name:</b></td><td><%= @boat.Name %></td>
      </tr>
      <tr>
	<td><b>Mfg/Size:</b></td><td><%= @boat.Mfg_Size %></td>
      </tr>
      <tr>
	<td><b>Type:</b></td><td><%= @boat.Type %></td>
      </tr> 
     <tr>
	<td><b>Length:</b></td><td><%= @boat.Length %></td>
      </tr>
      <tr>
	<td><b>Draft:</b></td><td><%= @boat.Draft %></td>
      </tr>
      <tr>
	<td><b>Mooring#:</b></td><td><%= @boat.mooring&.id %></td>
      </tr>
      <tr>
	<td><b>Drysail#:</b></td><td><%= @boat.drysail&.id %></td>
      </tr>
      <tr>
	<td><b>Sail#:</b></td><td><%= @boat.sail_num %></td>
      </tr>
    </tbody>
  </table>
  <% if not @boat.memberships.empty? %>
  <h3>Memberships</h3>
  <hr>
  <table class="table table-sm">
    <thead class="thead-light">
      <tr>
	<th>Last Name</th>
	<th>Mailing Name</th>
      </tr>
    </thead>
    <tbody>
      <% for membership in @boat.memberships %>
      <tr>
	<td><%= link_to membership.LastName, membership %></td>
	<td><%= membership.MailingName %></td>
	<% if current_user.roles?(['Harbormaster','BOG', 'Admin']) %>
	<td class="list-actions">
          <%= link_to "Remove Association", rmboat_membership_boat_path(membership, @boat), data: {turbo_confirm: "Are you sure?", turbo_method: :delete } %>
	</td>
	<% end %>
      </tr>
      <% end %>
    </tbody>
  </table>
  <% end %>
  <% if current_user.roles?(['Harbormaster','BOG', 'Admin']) %>
  <p>
    <%= link_to 'Associate with a membership', associate_boat_path(@boat) %>
  </p>
  <% end %>
</div>
