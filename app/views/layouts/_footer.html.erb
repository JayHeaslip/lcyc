<footer class="bg-white border-top shadow-sm py-3 mt-auto">
  <div class="container-fluid px-4">
    <div class="d-flex align-items-center justify-content-center gap-3 text-secondary small">
      <span class="mb-0">&copy; <%= Time.current.year %> Lake Champlain Yacht Club</span>
      <span>&bull;</span>
      <%= link_to "Privacy Policy", "/privacy_policy.html", class: "text-decoration-none text-secondary" %>
      <span>&bull;</span>
      <span class="mb-0">
        Revision: 
        <% if github_commit_link.present? %>
          <%= github_commit_link %>
        <% else %>
          dev
        <% end %>
      </span>
    </div>
  </div>
</footer>
